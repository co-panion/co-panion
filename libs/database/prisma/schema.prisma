// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"] // [PostGIS] 확장 활성화
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // 복구됨 (Prisma v6 필수)
  extensions = [postgis, vector] // [PostGIS] DB 엔진 설치 강제
}

// ==========================================
// [1] Enums (공통 상태 및 도메인)
// ==========================================
enum SocialProvider {
  KAKAO
  NAVER
  GOOGLE
  APPLE
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DORMANT
}

enum PartyType {
  INDIVIDUAL
  BUSINESS
  TEAM
}

enum PartyStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalStatus {
  RESCUED
  REUNITED
  PROTECTED
  AVAILABLE // 입양 공고 전환 상태 (상태 머신 전이 포인트)
  COUNSELING
  ADOPTED
  DECEASED
  EUTHANIZED
}

enum AdoptionApplicationStatus {
  PENDING
  COUNSELING
  INTERVIEW
  ADDITIONAL_INTERVIEW
  FOSTERING
  FINAL_REVIEW
  APPROVED
  REJECTED // 심사 락(Lock) 발동 대상
  CANCELED // 심사 락(Lock) 발동 대상
}

enum TargetType {
  PARTY_PROFILE
  SHELTER_BANNER
  ANIMAL
  RESCUE_POST
  ADOPTION_PROCESS
  POST
  MEDIA
  BOOKMARK // [Idempotency] 북마크 타겟
}

// [입양 설문 Enum] (수치형 변환 항목 제외)
enum PetExperience {
  NONE
  PAST
  CURRENT
}

enum ResidenceType {
  APARTMENT
  VILLA
  DETACHED_HOUSE
  OFFICETEL
  DORMITORY
}

enum PetPolicy {
  ALLOWED
  NOT_ALLOWED
  NEED_CONFIRMATION
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum IdentityVerificationMethod {
  MOBILE_SMS // KCB, NICE 등 전통적 휴대폰 SMS 인증
  PASS_APP // 통신사 PASS 앱 인증
  FINANCIAL_CERT // 금융인증서 (금융결제원 YESKEY 등)
  JOINT_CERT // 공동인증서 (구 공인인증서)
  SIMPLE_AUTH // 카카오, 네이버, 토스 등 민간 간편인증
}

// ==========================================
// [2] Module: Auth 
// ==========================================
model IntegratedAuthAccount {
  accountId String @id @default(uuid()) @map("account_id") @db.Uuid
  partyId   String @map("party_id") @db.Uuid
  username  String @unique @db.VarChar(100)

  // [GCIP 위임] passwordHash 제거, Firebase UID로 대체
  identityId      String        @unique @map("identity_id") @db.VarChar(128)
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")

  lastLoginTime DateTime? @map("last_login_time") @db.Timestamptz
  registerTime  DateTime? @default(now()) @map("register_time") @db.Timestamptz
  updateTime    DateTime? @updatedAt @map("update_time") @db.Timestamptz
  deleteTime    DateTime? @map("delete_time") @db.Timestamptz

  partyBase  PartyBase         @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  socialAuth SocialAuthDetail?

  @@index([deleteTime])
  @@map("integrated_auth_account")
}

model SocialAuthDetail {
  socialId   String         @id @default(uuid()) @map("social_id") @db.Uuid
  accountId  String         @unique @map("account_id") @db.Uuid
  provider   SocialProvider @map("provider")
  providerId String         @map("provider_id") @db.VarChar(255)

  registerTime DateTime? @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime? @updatedAt @map("update_time") @db.Timestamptz

  account IntegratedAuthAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_auth_detail")
}

// ==========================================
// [3] Module: Parties (주체 코어)
// ==========================================
model PartyBase {
  partyId    String      @id @default(uuid()) @map("party_id") @db.Uuid
  partyType  PartyType   @map("party_type")
  statusCode PartyStatus @default(ACTIVE) @map("status_code")

  registerTime DateTime? @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime? @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  individual PartyIndividual?
  business   PartyBusiness?
  team       PartyTeam?
  profile    PartyProfile?
  trait      UserAnalyticsTrait?

  accounts  IntegratedAuthAccount[]
  eventLogs UserEventLog[]
  contacts  PartyContactInfo[]
  bookmarks Bookmark[]
  chatLogs  AiChatSession[]

  memberships  PartyMembership[] @relation("MemberToGroup")
  groupMembers PartyMembership[] @relation("GroupToMember")

  shelters       Shelter[]         @relation("BusinessShelters")
  managedAnimals Animal[]          @relation("AnimalManager")
  rescuePosts    RescuePost[]
  adoptions      AdoptionProcess[]
  posts          Post[]
  comments       Comment[]

  @@index([deleteTime])
  @@map("party_base")
}

model PartyContactInfo {
  contactId String @id @default(uuid()) @map("contact_id") @db.Uuid
  partyId   String @map("party_id") @db.Uuid

  email         String? @db.VarChar(255)
  phoneNumber   String? @map("phone_number") @db.VarChar(50)
  extraContacts Json?   @map("extra_contacts") @db.JsonB

  isPrimary Boolean @default(false) @map("is_primary")

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  party PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@index([email])
  @@index([phoneNumber])
  @@map("party_contact_info")
}

model PartyIndividual {
  partyId  String @id @map("party_id") @db.Uuid
  nickname String @db.VarChar(100)

  di                 String                      @unique @db.VarChar(64)
  isIdentityVerified Boolean                     @default(false) @map("is_identity_verified")
  verificationMethod IdentityVerificationMethod? @map("verification_method")
  verifyTime         DateTime?                   @map("verify_time") @db.Timestamptz

  name            String? @map("real_name") @db.VarChar(50)
  birthDateString String  @map("birth_date") @db.Char(8)
  gender          String  @db.Char(1)

  partyBase PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("party_individual")
}

model PartyBusiness {
  partyId            String             @id @map("party_id") @db.Uuid
  businessName       String             @map("business_name") @db.VarChar(150)
  countryCode        String             @default("KR") @map("country_code") @db.Char(2)
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  bcode              String?            @db.Char(10)

  partyBase   PartyBase            @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  koreaDetail BusinessKoreaDetail?

  @@index([bcode])
  @@map("party_business")
}

model PartyTeam {
  partyId  String @id @map("party_id") @db.Uuid
  teamName String @map("team_name") @db.VarChar(100)

  partyBase PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("party_team")
}

model BusinessKoreaDetail {
  partyId          String    @id @map("party_id") @db.Uuid
  ntsStatusCode    String?   @map("nts_status_code") @db.VarChar(20)
  fscIndustryCode  String?   @map("fsc_industry_code") @db.VarChar(20)
  lastVerifiedTime DateTime? @map("last_verified_time") @db.Timestamptz

  business PartyBusiness @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("business_korea_detail")
}

model PartyProfile {
  profileId   String @id @default(uuid()) @map("profile_id") @db.Uuid
  partyId     String @unique @map("party_id") @db.Uuid
  profileData Json?  @map("profile_data") @db.JsonB

  registerTime DateTime? @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime? @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  partyBase PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("party_profile")
}

model PartyMembership {
  membershipId String           @id @default(uuid()) @map("membership_id") @db.Uuid
  memberId     String           @map("member_id") @db.Uuid
  groupId      String           @map("group_id") @db.Uuid
  role         MembershipRole   @default(MEMBER) @map("role")
  status       MembershipStatus @default(ACTIVE) @map("status")
  joinedTime   DateTime         @default(now()) @map("joined_time") @db.Timestamptz

  member PartyBase @relation("MemberToGroup", fields: [memberId], references: [partyId], onDelete: Cascade)
  group  PartyBase @relation("GroupToMember", fields: [groupId], references: [partyId], onDelete: Cascade)

  @@unique([memberId, groupId])
  @@index([groupId])
  @@map("party_membership")
}

// ==========================================
// [4] Module: Analytics & Audit
// ==========================================
model UserEventLog {
  eventId         String   @id @default(uuid()) @map("event_id") @db.Uuid
  partyId         String   @map("party_id") @db.Uuid
  eventCategory   String   @map("event_category") @db.VarChar(50)
  eventName       String   @map("event_name") @db.VarChar(50)
  eventProperties Json     @map("event_properties") @db.JsonB
  eventTime       DateTime @default(now()) @map("event_time") @db.Timestamptz

  partyBase PartyBase @relation(fields: [partyId], references: [partyId])

  @@index([partyId, eventTime])
  @@index([eventCategory, eventName])
  @@map("user_event_log")
}

model UserAnalyticsTrait {
  partyId            String   @id @map("party_id") @db.Uuid
  calculatedTraits   Json     @map("calculated_traits") @db.JsonB
  lastCalculatedTime DateTime @default(now()) @map("last_calculated_time") @db.Timestamptz

  partyBase PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@map("user_analytics_trait")
}

model AccountAuditLog {
  logId          String  @id @default(uuid()) @map("log_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  encryptedEmail String  @map("encrypted_email") @db.VarChar(255)
  reasonCode     String  @map("reason_code") @db.Char(2)
  reasonMetadata Json?   @map("reason_metadata") @db.JsonB
  clientIp       String? @map("client_ip") @db.VarChar(50)

  withdrawnTime DateTime @default(now()) @map("withdrawn_time") @db.Timestamptz
  expireTime    DateTime @map("expire_time") @db.Timestamptz

  @@index([accountId])
  @@index([expireTime])
  @@map("account_audit_log")
}

model ExternalApiCallLog {
  logId           String  @id @default(uuid()) @map("log_id") @db.Uuid
  apiCategory     String  @map("api_category") @db.Char(4)
  apiProvider     String  @map("api_provider") @db.Char(4)
  endpointUrl     String  @map("endpoint_url") @db.VarChar(255)
  referenceId     String? @map("reference_id") @db.Uuid
  referenceType   String? @map("reference_type") @db.VarChar(50)
  requestPayload  Json?   @map("request_payload") @db.JsonB
  responsePayload Json?   @map("response_payload") @db.JsonB
  httpStatusCode  Int?    @map("http_status_code")
  durationMs      Int?    @map("duration_ms")
  isSuccess       Boolean @map("is_success")

  registerTime DateTime @default(now()) @map("register_time") @db.Timestamptz

  @@index([apiCategory, apiProvider])
  @@index([referenceId, referenceType])
  @@map("external_api_call_log")
}

// [AI 챗봇 컴플라이언스] - 임시
model AiChatSession {
  sessionId        String @id @default(uuid()) @map("session_id") @db.Uuid
  partyId          String @map("party_id") @db.Uuid
  complianceStatus String @default("SAFE") @map("compliance_status") @db.VarChar(20)

  registerTime DateTime @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime @updatedAt @map("update_time") @db.Timestamptz

  partyBase PartyBase       @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  messages  AiChatMessage[]

  @@map("ai_chat_session")
}

// [AI 챗봇 컴플라이언스] - 임시
model AiChatMessage {
  messageId String        @id @default(uuid()) @map("message_id") @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  role      AiMessageRole @map("role")
  content   String        @map("content") @db.Text

  registerTime DateTime @default(now()) @map("register_time") @db.Timestamptz

  session AiChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId, registerTime])
  @@map("ai_chat_message")
}

// ==========================================
// [5] Module: Shelter
// ==========================================
model Shelter {
  id             String @id @default(uuid()) @map("id") @db.Uuid
  businessId     String @map("business_id") @db.Uuid
  name           String @map("name") @db.VarChar(100)
  phone          String @map("phone") @db.VarChar(20)
  operatingHours String @map("operating_hours") @db.VarChar(100)
  description    String @map("description") @db.VarChar(500)

  // [Hybrid] UI 정규화 주소(JSONB) + 반경 검색 좌표(Geometry)
  locationData Json                                  @map("location_data") @db.JsonB
  geom         Unsupported("geometry(Point, 4326)")?

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  business PartyBase @relation("BusinessShelters", fields: [businessId], references: [partyId], onDelete: Cascade)
  animals  Animal[]  @relation("ShelterLocation")

  @@index([businessId, deleteTime])
  @@index([geom], name: "shelter_geom_idx", type: Gist) // PostGIS 공간 인덱스
  @@map("shelter")
}

// ==========================================
// [6] Module: Animal & Transactions
// ==========================================
model Animal {
  id             Int     @id @default(autoincrement()) @map("id")
  managerPartyId String  @map("manager_party_id") @db.Uuid
  shelterId      String? @map("shelter_id") @db.Uuid

  speciesId      Int     @map("species_id") @db.SmallInt
  breedId        Int     @map("breed_id") @db.SmallInt
  name           String  @map("name") @db.VarChar(50)
  gender         Gender  @map("gender")
  isNeutered     Boolean @map("is_neutered")
  age            Int?    @map("age") @db.SmallInt
  isEstimatedAge Boolean @map("is_estimated_age")
  weight         Decimal @map("weight") @db.Decimal(5, 2)

  // [State Machine] 구조글 ➔ 입양 공고 전이 추적
  animalStatus AnimalStatus @default(RESCUED) @map("animal_status")
  convertTime  DateTime?    @map("convert_time") @db.Timestamptz

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  managerParty PartyBase     @relation("AnimalManager", fields: [managerPartyId], references: [partyId], onDelete: Restrict)
  shelter      Shelter?      @relation("ShelterLocation", fields: [shelterId], references: [id], onDelete: SetNull)
  species      AnimalSpecies @relation(fields: [speciesId], references: [id])
  breed        AnimalBreed   @relation(fields: [breedId], references: [id])

  rescuePosts RescuePost[]
  adoptions   AdoptionProcess[]

  @@index([animalStatus, deleteTime])
  @@index([managerPartyId])
  @@map("animal")
}

model AnimalSpecies {
  id      Int           @id @default(autoincrement()) @map("id") @db.SmallInt
  name    String        @map("name") @db.VarChar(30)
  breeds  AnimalBreed[]
  animals Animal[]

  @@map("animal_species")
}

model AnimalBreed {
  id        Int           @id @default(autoincrement()) @map("id") @db.SmallInt
  speciesId Int           @map("species_id") @db.SmallInt
  name      String        @map("name") @db.VarChar(30)
  species   AnimalSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  animals   Animal[]

  @@index([speciesId])
  @@map("animal_breed")
}

model RescuePost {
  id            String   @id @default(uuid()) @map("id") @db.Uuid
  animalId      Int      @map("animal_id")
  authorPartyId String   @map("author_party_id") @db.Uuid
  title         String   @map("title") @db.VarChar(100)
  foundTime     DateTime @map("found_time") @db.Timestamptz
  description   String   @map("description") @db.Text

  // [Hybrid] 구조 발견 위치 (오픈 API 연동 + 카카오맵 핀)
  locationData Json                                  @map("location_data") @db.JsonB
  geom         Unsupported("geometry(Point, 4326)")?

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  animal      Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  authorParty PartyBase @relation(fields: [authorPartyId], references: [partyId], onDelete: Cascade)

  @@index([animalId, deleteTime])
  @@index([geom], name: "rescue_geom_idx", type: Gist)
  @@map("rescue_post")
}

model AdoptionProcess {
  id               String                    @id @default(uuid()) @map("id") @db.Uuid
  animalId         Int                       @map("animal_id")
  applicantPartyId String                    @map("applicant_party_id") @db.Uuid
  status           AdoptionApplicationStatus @default(PENDING) @map("status")
  internalNotes    Json?                     @map("internal_notes") @db.JsonB

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  animal         Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  applicantParty PartyBase       @relation(fields: [applicantPartyId], references: [partyId], onDelete: Cascade)
  detail         AdoptionDetail?

  @@index([animalId, status, deleteTime])
  @@map("adoption_process")
}

model AdoptionDetail {
  id                String @id @default(uuid()) @map("id") @db.Uuid
  adoptionProcessId String @unique @map("adoption_process_id") @db.Uuid
  applicantName     String @map("applicant_name") @db.VarChar(30)

  familySize       Int  @map("family_size") @db.SmallInt
  youngestChildAge Int? @map("youngest_child_age") @db.SmallInt

  petExperience       PetExperience @map("pet_experience")
  petExperienceMonths Int?          @map("pet_experience_months") @db.SmallInt
  residenceType       ResidenceType @map("residence_type")
  petPolicy           PetPolicy     @map("pet_policy")
  isFamilyConsented   Boolean       @default(false) @map("is_family_consented")

  // [PII Lifecycle] 90일 후 스케줄러(Cron)에 의한 자동 파기 기준 시간
  piiDisposeTime DateTime? @map("pii_dispose_time") @db.Timestamptz
  updateTime     DateTime  @updatedAt @map("update_time") @db.Timestamptz

  adoptionProcess AdoptionProcess @relation(fields: [adoptionProcessId], references: [id], onDelete: Cascade)

  @@map("adoption_detail")
}

// ==========================================
// [7] Module: Media, Comments & Tags
// ==========================================
model Media {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid
  mediaUrl   String     @map("media_url") @db.Text
  orderSeq   Int        @default(0) @map("order_seq")
  metadata   Json?      @map("metadata") @db.JsonB

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz
  // [고아 파일 정리] deleteTime이 찍힌 레코드는 비동기 Batch Job(S3 Sync)을 통해 실제 파일 삭제 및 레코드 Hard Delete 처리

  @@index([targetType, targetId, deleteTime])
  @@map("media")
}

// [Idempotency] 복합 유니크 인덱스를 통한 북마크 낙관적 업데이트 락(Lock)
model Bookmark {
  bookmarkId String     @id @default(uuid()) @map("bookmark_id") @db.Uuid
  partyId    String     @map("party_id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid

  registerTime DateTime @default(now()) @map("register_time") @db.Timestamptz

  partyBase PartyBase @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  @@unique([partyId, targetType, targetId]) // 레이스 컨디션 방어 및 멱등성 보장
  @@map("bookmark")
}

model Post {
  id       String @id @default(uuid()) @map("id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  title    String @map("title") @db.VarChar(50)
  content  String @map("content") @db.Text

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  author PartyBase @relation(fields: [authorId], references: [partyId], onDelete: Cascade)

  @@index([authorId, deleteTime])
  @@map("post")
}

// [통합 댓글 시스템 - 1-Depth UX 제한형]
model Comment {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  authorId   String     @map("author_id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid

  rootId   String? @map("root_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  content String @map("content") @db.Text

  registerTime DateTime  @default(now()) @map("register_time") @db.Timestamptz
  updateTime   DateTime  @updatedAt @map("update_time") @db.Timestamptz
  deleteTime   DateTime? @map("delete_time") @db.Timestamptz

  author PartyBase @relation(fields: [authorId], references: [partyId], onDelete: Cascade)

  root   Comment? @relation("Thread", fields: [rootId], references: [id], onDelete: Cascade)
  parent Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)

  threadReplies Comment[] @relation("Thread")
  replies       Comment[] @relation("Replies")

  @@index([targetType, targetId, rootId, deleteTime])
  @@map("comment")
}

model Hashtag {
  id   String @id @default(uuid()) @map("id") @db.Uuid
  name String @unique @map("name") @db.VarChar(50)

  mappings HashtagMapping[]

  @@map("hashtag")
}

model HashtagMapping {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  hashtagId  String     @map("hashtag_id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid

  registerTime DateTime @default(now()) @map("register_time") @db.Timestamptz

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("hashtag_mapping")
}
