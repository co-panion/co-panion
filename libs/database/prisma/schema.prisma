// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")                                              // 복구됨 (Prisma v6 필수)
}

// ----------------------------------------------------
// [Enums] (작성자 원본 유지)
// ----------------------------------------------------
enum Gender { 
  MALE 
  FEMALE 
  UNKNOWN 
}

enum AnimalStatus { 
  PROTECTED
  AVAILABLE
  ADOPTED
  REUNITED
  DECEASED
  EUTHANIZED 
}

enum AdoptionStatus { 
  PENDING
  COUNSELING
  INTERVIEW
  ADDITIONAL_INTERVIEW
  FOSTERING
  FINAL_REVIEW
  APPROVED
  REJECTED
  CANCELED 
}

enum PetExperience { 
  NONE
  PAST
  CURRENT 
}

enum PetExperiencePeriod { 
  LESS_THAN_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  OVER_FIVE_YEARS 
}

enum ResidenceType { 
  APARTMENT
  VILLA
  DETACHED_HOUSE
  OFFICETEL
  DORMITORY 
}

enum PetPolicy { 
  ALLOWED
  NOT_ALLOWED
  NEED_CONFIRMATION
}

enum FamilySize { 
  ONE
  TWO
  THREE
  FOUR_OR_MORE 
}

enum ChildrenAgeGroup { 
  NONE
  UNDER_SEVEN
  SEVEN_OR_OLDER 
}

enum UserStatus { 
  ACTIVE
  INACTIVE
  SUSPENDED
  WITHDRAWN
}

enum Role { 
  USER 
  SHELTER 
  ADMIN 
}

// ----------------------------------------------------
// [Entities]
// ----------------------------------------------------

model User {
  id         String     @id @default(uuid()) @db.Uuid
  shelterId  String?    @db.Uuid
  email      String     @unique @db.VarChar(255)
  password   String     @db.VarChar(255)
  nickname   String     @db.VarChar(20)
  role       Role
  imgProfile String     @db.VarChar(100)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  shelter    Shelter?   @relation(fields: [shelterId], references: [id])        // [수정] Shelter 관계 명시

  agreements UserAgreement[]
  adoptions  Adoption[]
  inquiries  Inquiry[]
  petPosts   PetPost[]                                                          // [수정] 역방향 관계 명시
}

model Shelter {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  address        String   @db.VarChar(255)
  addressDetail  String?  @db.VarChar(255)
  phone          String   @db.VarChar(20)
  operatingHours String   @db.VarChar(100)
  description    String   @db.VarChar(500)
  imgBanner      String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]                                                           // [수정] 역방향 관계 명시
  images         ShelterImage[]
  animals        Animal[]
}

model ShelterImage {
  id        String  @id @default(uuid()) @db.Uuid
  shelterId String  @db.Uuid
  img       String  @db.VarChar(100)
  
  shelter   Shelter @relation(fields: [shelterId], references: [id])
}

model Animal {
  id             Int          @id @default(autoincrement())
  shelterId      String       @db.Uuid
  name           String       @db.VarChar(50)
  
  speciesId      Int          @db.SmallInt                                        // [수정] 외래키 필드명 명확화 (Id 접미사 추가)
  breedId        Int          @db.SmallInt
  
  gender         Gender
  isNeutered     Boolean
  age            Int          @db.SmallInt
  isEstimatedAge Boolean
  animalStatus   AnimalStatus @default(PROTECTED)
  weight         Decimal      @db.Decimal(5, 2)
  imgThumbnail   String       @db.VarChar(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shelter        Shelter      @relation(fields: [shelterId], references: [id])
  
  
  species        AnimalSpecies @relation(fields: [speciesId], references: [id])  // [수정] 종/품종 관계 명시
  breed          AnimalBreed   @relation(fields: [breedId], references: [id])
  
  images         AnimalImage[]
  detail         AnimalDetail?
}

model AnimalSpecies {
  id      Int      @id @default(autoincrement()) @db.SmallInt
  name    String   @db.VarChar(30)
  
  animals Animal[]                                                              // [수정] 역방향 관계 명시
}

model AnimalBreed {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  
  speciesId Int      @db.SmallInt
  name      String   @db.VarChar(30)
  
  species   AnimalSpecies @relation(fields: [speciesId], references: [id])      // [수정] 종목 관계 명시를 위해 필드명 변경 및 관계 추가
  animals   Animal[]                                                            // [수정] 역방향 관계 명시
}

model AnimalDetail {
  id              String   @id @default(uuid()) @db.Uuid                        // [수정] autoincrement 제거 (매우 중요)
  animalId        Int      @unique
  noticeStartDate DateTime @db.Date
  noticeEndDate   DateTime @db.Date
  foundLocation   String   @db.VarChar(50)
  specialNotes    String   @db.VarChar(100)
  description     String   @db.VarChar(500)
  healthStatus    String   @db.VarChar(500)
  updatedAt       DateTime @updatedAt
  
  animal          Animal   @relation(fields: [animalId], references: [id])
}

model AnimalImage {
  id       String @id @default(uuid()) @db.Uuid
  animalId Int
  img      String @db.VarChar(100)
  
  animal   Animal @relation(fields: [animalId], references: [id])
}

model Adoption {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  animalId       Int
  adoptionStatus AdoptionStatus
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  detail         AdoptionDetail?
  agreements     AdoptionAgreement[]
}

model AdoptionDetail {
  id                  String               @id @default(uuid()) @db.Uuid
  adoptionId          String               @unique @db.Uuid
  userName            String               @db.VarChar(30)
  email               String               @db.VarChar(255)
  phone               String               @db.VarChar(20)
  address             String               @db.VarChar(255)
  addressDetail       String?              @db.VarChar(255)
  petExperience       PetExperience
  petDescription      String?              @db.VarChar(100)
  petExperiencePeriod PetExperiencePeriod?
  residenceType       ResidenceType
  petPolicy           PetPolicy
  familySize          FamilySize
  childrenAgeGroup    ChildrenAgeGroup
  isFamilyConsented   Boolean              @default(false)
  purpose             String               @db.VarChar(100)
  canVaccinate        Boolean
  canProvideMedical   Boolean
  canProvideExercise  Boolean
  isLifelongCommit    Boolean
  note                String               @db.VarChar(500)
  updatedAt           DateTime             @updatedAt

  adoption            Adoption             @relation(fields: [adoptionId], references: [id])
}

model Agreement {
  id      Int    @id @default(autoincrement()) @db.SmallInt
  title   String @db.VarChar(50)
  content String @db.Text
}

model UserAgreement {
  id          String   @id @default(uuid()) @db.Uuid
  agreementId Int      @db.SmallInt
  userId      String   @db.Uuid
  isAgreed    Boolean
  agreedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model AdoptionAgreement {
  id          String   @id @default(uuid()) @db.Uuid
  agreementId Int      @db.SmallInt
  adoptionId  String   @db.Uuid
  isAgreed    Boolean
  agreedAt    DateTime @default(now())

  adoption    Adoption @relation(fields: [adoptionId], references: [id])
}

model PetPost {
  id        Int      @id @default(autoincrement())
  authorId  String   @db.Uuid
  title     String   @db.VarChar(50)
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  
  
  author    User     @relation(fields: [authorId], references: [id])          // [수정] 작성자(User) 관계 명시
  images    PetPostImage[]
}

model PetPostImage {
  id        String  @id @default(uuid()) @db.Uuid
  petPostId Int
  img       String  @db.VarChar(100)

  petPost   PetPost @relation(fields: [petPostId], references: [id])
}

//TODO 임시 (Test) : 테스트 후 아키텍처 수정 보완
model Inquiry {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  title     String  @db.VarChar(200)
  content   String  @db.Text
  
  user      User    @relation(fields: [userId], references: [id])
}
