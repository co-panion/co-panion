{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2022",
    "noEmit": false
  },
  "include": [
    "src/**/*",
    "tailwind.config.ts",
    "tailwind.preset.ts"
  ],
  "exclude": ["node_modules", "dist"]
}