{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    //"target": "ES2017",
    //"skipLibCheck": true,
    //"strict": true,
    //"esModuleInterop": true,
    //"isolatedModules": true,
    //"incremental": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  //"exclude": ["node_modules"]
}
