{
  "name": "co-panion",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema=libs/database/prisma/schema.prisma",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "check-types": "turbo run check-types",
    "docs:generate": "turbo run docs:generate",
    "docs:build": "pnpm --filter docs typedoc && pnpm --filter api docs:generate && pnpm --filter docs build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@swc/helpers": "^0.5.23",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.7.4",
    "prisma": "^6.19.3",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm-instead"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "volta": {
    "node": "20.11.0",
    "pnpm": "9.0.0"
  },
  "prisma": {
    "schema": "libs/database/prisma/schema.prisma"
  }
}
